<Window x:Class="UchebPract2022.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UchebPract2022"
        mc:Ignorable="d"
        Title="Добавление продукции" Height="650" Width="500">
    <Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Кнопка Назад -->
            <Button Content="Назад" Click="BackButton_Click" Grid.Row="0" HorizontalAlignment="Left" Width="80" Height="25" Margin="0,0,0,10"/>

            <!-- Название -->
            <TextBlock Text="Название:" Grid.Row="1" Margin="0,0,0,5"/>
            <TextBox x:Name="NameBox" Grid.Row="2" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

            <!-- Тип товара -->
            <TextBlock Text="Тип товара:" Grid.Row="3" Margin="0,0,0,5"/>
            <ComboBox x:Name="TypeBox" Grid.Row="4" DisplayMemberPath="ProductType" SelectedValuePath="ProductTypeID" Height="25" Margin="0,0,0,10"/>

            <!-- Описание -->
            <TextBlock Text="Описание:" Grid.Row="5" Margin="0,0,0,5"/>
            <TextBox x:Name="DescriptionBox" Grid.Row="6" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

            <!-- Состав -->
            <TextBlock Text="Состав:" Grid.Row="7" Margin="0,0,0,5"/>
            <TextBox x:Name="CompositionBox" Grid.Row="8" TextWrapping="Wrap" Height="60" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto"/>

            <!-- Цена -->
            <TextBlock Text="Цена:" Grid.Row="9" Margin="0,0,0,5"/>
            <TextBox x:Name="PriceBox" Grid.Row="10" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

            <!-- Скидка -->
            <TextBlock Text="Скидка (%):" Grid.Row="11" Margin="0,0,0,5"/>
            <TextBox x:Name="DiscountBox" Grid.Row="12" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

            <!-- Изображение -->
            <TextBlock Text="Изображение:" Grid.Row="13" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Grid.Row="14">
                <Button Content="Выбрать..." Click="SelectImage_Click" Width="100" Height="25"/>
                <TextBlock x:Name="ImageNameText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
            </StackPanel>

            <!-- Кнопки сохранить / удалить -->
            <StackPanel Orientation="Horizontal" Grid.Row="15" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Сохранить" Click="SaveButton_Click" Width="80" Height="25" Margin="0,0,10,0"/>
                <Button Content="Отмена" Click="CancelButton_Click" Width="80" Height="25" Margin="0,0,10,0"/>
                <Button x:Name="DeleteButton" Content="Удалить" Click="DeleteButton_Click" Width="80" Height="25"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
