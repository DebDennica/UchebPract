<Window x:Class="UchebPract2022.Autorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UchebPract2022"
        mc:Ignorable="d"
        Title="Autorization" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="10">
            <Button x:Name="ForwardButton" Content="Назад" Click="ForwardButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0"/>
            <TextBlock Text="Авторизация" HorizontalAlignment="Center" Margin="0 0 0 10"/>
            <TextBlock Text="Логин" Margin="0 5 0 0"/>
            <TextBox x:Name="LoginEnter" Margin="5"/>
            <TextBlock Text="Пароль" Margin="0 5 0 0"/>
            <PasswordBox x:Name="PasswordEnter" Margin="5"/>
            <Button x:Name="LoginButton" Content="Войти" Click="LoginButton_Click" Margin="10 5 10 5"/>
            <TextBlock Text="Войти как гость" MouseDown="TextBlock_MouseDown" HorizontalAlignment="Center" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
